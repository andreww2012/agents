{
  "name": "@andreww2012/ai-guidelines",
  "version": "0.2.0",
  "description": "Generic guidelines for AI coding agents and a CLI to set them up in your project",
  "keywords": [
    "agents",
    "agents-md",
    "ai",
    "cli",
    "guidelines",
    "claude",
    "codex"
  ],
  "homepage": "https://github.com/andreww2012/ai-guidelines",
  "bugs": {
    "url": "https://github.com/andreww2012/ai-guidelines/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/ai-guidelines.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": "dist/cli.mjs",
  "files": [
    ".agents/guidelines.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "nr build",
    "prepublishOnly": "nr check:package",
    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "ncu --dep packageManager",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "oxfmt --check",
    "format": "oxfmt",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "eslint --cache",
    "ts": "tsc --noEmit",
    "ts6": "tsc6 --noEmit",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(dedupe|peers))$/\"",
    "check:package": "pnpm pack --out temp/package.tgz && nr check:package:attw && nr check:package:publint",
    "check:package:attw": "attw temp/package.tgz --profile esm-only",
    "check:package:publint": "publint temp/package.tgz --strict",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test": "nr check:deps && nr check && nr test:vitest",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "cleye": "2.7.0",
    "consola": "3.4.2"
  },
  "devDependencies": {
    "@andreww2012/unutils": "0.2.0",
    "@antfu/ni": "30.6.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/config-inspector": "3.5.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.3",
    "actions-up": "1.21.0",
    "cross-env": "10.1.0",
    "cspell": "10.3.6",
    "eslint": "10.12.0",
    "eslint-config-un": "1.0.0-rc.4",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-github-action": "0.4.0",
    "eslint-plugin-sentences-per-line": "0.1.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.40.0",
    "lefthook": "2.1.17",
    "npm-check-updates": "23.1.0",
    "oxfmt": "catalog:format",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "verkit": "0.5.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^24.18.0 || >=26.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2"
    }
  }
}
